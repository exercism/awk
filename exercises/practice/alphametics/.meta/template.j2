{{ header }}
{% for case in cases %}
@test "{{ case.description }}" {
  {% if not loop.first %}# {% endif %}[[ $BATS_RUN_SKIPPED == "true" ]] || skip
  run awk -f alphametics.awk <<< "{{ case.input.puzzle }}"
  assert_success
  {% if case.expected %}
  assert_output "{{ [letter ~ '=' ~ digit for letter, digit in case.expected.items() | sort] | join(' ') }}"
  {% else %}
  refute_output
  {% endif %}
}
{% endfor %}
