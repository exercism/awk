{{ header }}
{% for case in cases %}
@test "{{ case["description"] }}" {
    {% if loop.first %}# {% endif %}[[ $BATS_RUN_SKIPPED == "true" ]] || skip
    run gawk -f {{ solution }} <<< "{{ (case["input"]["dice"] + [case["input"]["category"]]) | join(",") }}"
    assert_success
    assert_output {{ case["expected"] }}
}
{% endfor %}
