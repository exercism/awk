{{ header }}
{% for case in cases %}
@test "{{ case["description"] }}" {
    {% if loop.first %}# {% endif %}[[ $BATS_RUN_SKIPPED == "true" ]] || skip
    run gawk -f {{ solution }} -v limit={{ case["input"]["limit"] }} <<< "{{ case["input"]["factors"] | join(" ") }}"
    assert_success
    assert_output "{{ case["expected"] }}"
}
{% endfor %}
